/angular-app/dist
/angular-app/tmp
/angular-app/out-tsc
/angular-app/bazel-out

# Node
/angular-app/node_modules
/angular-app/npm-debug.log
/angular-app/yarn-error.log

# IDEs and editors
/angular-app/.idea/
/angular-app/.project
/angular-app/.classpath
/angular-app/.c9/
/angular-app/*.launch
/angular-app/.settings/
/angular-app/*.sublime-workspace

# Visual Studio Code
/angular-app/.vscode/*
/angular-app/!.vscode/settings.json
/angular-app/!.vscode/tasks.json
/angular-app/!.vscode/launch.json
/angular-app/!.vscode/extensions.json
/angular-app/.history/*

# Miscellaneous
