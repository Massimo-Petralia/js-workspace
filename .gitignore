# NEST-APP
# compiled output
/nest-app/dist
/nest-app/node_modules
/nest-app/build

# Logs
/nest-app/logs
/nest-app/*.log
/nest-app/npm-debug.log*
/nest-app/pnpm-debug.log*
/nest-app/yarn-debug.log*
/nest-app/yarn-error.log*
/nest-app/lerna-debug.log*

# OS
/nest-app/.DS_Store

# Tests
/nest-app/coverage
/nest-app/.nyc_output

# IDEs and editors
/nest-app/.idea
/nest-app/.project
/nest-app/.classpath
/nest-app/.c9/
/nest-app/*.launch
/nest-app/.settings/
/mest-app/*.sublime-workspace

# IDE - VSCode
/nest-app/.vscode/*
/nest-app/!.vscode/settings.json
/nest-app/!.vscode/tasks.json
/nest-app/!.vscode/launch.json
/nest-app/!.vscode/extensions.json

# dotenv environment variable files
/nest-app/.env
/nest-app/.env.development.local
/nest-app/.env.test.local
/nest-app/.env.production.local
/nest-app/.env.local

# temp directory
/nest-app/.temp
/nest-app/.tmp

# Runtime data
/nest-app/pids
/nest-app/*.pid
/nest-app/*.seed
/nest-app/*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
/nest-app/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

